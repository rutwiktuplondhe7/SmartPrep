# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on. Keep 8000: the frontend calls http://localhost:8000 by default.
PORT=8000

# MongoDB connection string.
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartprep
#   Local: mongodb://127.0.0.1:27017/smartprep
MONGO_URI=your_mongodb_connection_string

# Any long random string used to sign login tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret

# Key from https://openrouter.ai/keys (used for AI-generated questions and explanations).
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: only needed if the frontend runs somewhere other than
# http://localhost:5173 or http://localhost:3000
# CLIENT_URL=http://localhost:5173
